{
  "name": "relay-link",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-01",
  "workers_dev": true,
  "routes": [{ "pattern": "relay.matari-audio.com", "custom_domain": true }],
  // /listen.* and / are served straight from here; /<room> goes through the worker.
  "assets": { "directory": "./public", "binding": "ASSETS" },
  "durable_objects": {
    "bindings": [{ "name": "ROOM", "class_name": "Room" }]
  },
  // v2 adds Room; v3 drops the old SessionRoom and its storage.
  "migrations": [
    { "tag": "v1-session-room", "new_sqlite_classes": ["SessionRoom"] },
    { "tag": "v2-room", "new_sqlite_classes": ["Room"] },
    // Split from v2: a class can only be deleted once no live version binds it.
    { "tag": "v3-drop-session-room", "deleted_classes": ["SessionRoom"] }
  ],
  // Secrets: TURN_KEY_ID, TURN_KEY_TOKEN (wrangler secret put). Optional var EXTRA_ICE (JSON).
  "observability": { "enabled": true, "head_sampling_rate": 0.01 }
}
