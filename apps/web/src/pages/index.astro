---
import Base from "../layouts/Base.astro";

const listen = "https://relay.matari-audio.com";
const download = "https://matari-audio.com/relay";

const paths = [
  ["LAN", "lossless float PCM"],
  ["Internet", "WebRTC, Opus 510 kbps"],
  ["Browser", "a link, nothing to install"],
];
---

<Base
  title="RELAY: share your track peer to peer"
  description="RELAY is a CLAP, VST3 and AU insert that sends and receives DAW audio peer to peer. Browser listeners hear both plugins. No account, no server in the audio path."
>
  <main class="card">
    <header>
      <svg class="mark" viewBox="0 0 100 100" aria-hidden="true">
        <circle cx="24" cy="50" r="9" fill="currentColor" stroke="none" />
        <path d="M42 26L56 50L42 74" /><path d="M66 26L80 50L66 74" />
      </svg>
      <h1>RELAY</h1>
    </header>
    <form class="controls" id="join" action={listen}>
      <label class="field">
        <svg viewBox="0 0 16 16" aria-hidden="true"><path d="M6.5 2.5l-2 11M11.5 2.5l-2 11M2.5 6h11M2 10h11" /></svg>
        <input name="room" aria-label="Room" autocomplete="off" spellcheck="false" placeholder="room-name" enterkeyhint="go" />
      </label>
      <button>
        <svg viewBox="0 0 12 12" aria-hidden="true"><path d="M2 1l9 5-9 5z" /></svg>
        Join
      </button>
      <p>Send and receive DAW audio with another RELAY. Browser listeners hear both plugins. <a href={download}>Get the plugin</a></p>
    </form>
    <div class="meters" aria-hidden="true"><i></i><i></i></div>
  </main>

  <dl>
    {paths.map(([to, how]) => (<div><dt>{to}</dt><dd>{how}</dd></div>))}
  </dl>
</Base>

<script>
  // Same rule as relay_core::slug, so the link lands on a valid room.
  const form = document.getElementById("join") as HTMLFormElement;
  form.addEventListener("submit", (e) => {
    e.preventDefault();
    const room = String(new FormData(form).get("room") ?? "")
      .trim().toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-+|-+$/g, "").slice(0, 48);
    location.assign(room ? `${form.action}/${room}` : form.action);
  });
</script>

<style>
  .card {
    display: grid;
    grid-template-columns: 1fr auto;
    gap: 10px 12px;
    padding: 12px;
    border: 1px solid var(--line);
    border-radius: var(--r);
  }

  header { grid-column: 1 / -1; display: flex; align-items: center; gap: 8px; height: 20px; }
  h1 { margin: 0; font-size: 15px; letter-spacing: 0.06em; }
  .mark { width: 18px; height: 18px; color: var(--accent); stroke: currentColor; stroke-width: 13; stroke-linecap: round; stroke-linejoin: round; fill: none; }

  .controls { display: grid; gap: 8px; min-width: 0; }
  .field { display: flex; align-items: center; height: 36px; border-radius: var(--r); background: var(--field); }
  .field:hover { background: var(--hover); }
  .field:focus-within { box-shadow: inset 0 0 0 1px var(--accent); }
  .field svg { flex: none; width: 36px; height: 36px; padding: 10px; color: var(--dim); fill: none; stroke: currentColor; stroke-width: 1.8; stroke-linecap: round; }
  input { flex: 1; min-width: 0; height: 100%; border: 0; padding: 0; background: none; color: var(--text); font: inherit; font-size: 15px; outline: none; }
  input::placeholder { color: var(--dim); }

  button {
    height: 36px;
    display: flex;
    align-items: center;
    justify-content: center;
    gap: 8px;
    border: 0;
    border-radius: var(--r);
    background: var(--accent);
    color: var(--ink);
    font: 700 14px Barlow, sans-serif;
    letter-spacing: 0.1em;
    text-transform: uppercase;
    cursor: pointer;
  }
  button svg { width: 12px; height: 12px; fill: currentColor; }
  button:hover { filter: brightness(1.1); }

  p { margin: 0; color: var(--dim); }

  .meters { display: flex; gap: 1px; }
  .meters i { width: 16px; border-radius: 2px; background: #0a0a0a; }

  dl { margin: 16px 0 0; display: grid; gap: 4px; }
  dl div { display: flex; justify-content: space-between; gap: 12px; }
  dt { color: var(--dim); }
  dd { margin: 0; }
</style>
