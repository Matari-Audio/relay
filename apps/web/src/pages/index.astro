---
import Base from "../layouts/Base.astro";

const listen = "https://relay.matari-audio.com";
const download = "https://matari-audio.com/relay";

const paths = [
  { to: "Another RELAY on your LAN", how: "Lossless float PCM over UDP", spec: "No codec, no added latency" },
  { to: "Another RELAY over the internet", how: "WebRTC, peer to peer", spec: "Opus 510 kbps, adaptive jitter buffer" },
  { to: "Anyone's browser", how: "A link: relay.matari-audio.com/<room>", spec: "Opus 510 kbps, nothing to install" },
];
---

<Base
  title="RELAY: share your track peer to peer"
  description="RELAY is a CLAP and VST3 insert that shares the track it sits on, peer to peer, to another RELAY or to anyone's browser. No account, no server in the audio path."
>
  <main>
    <h1>Share your track, peer to peer.</h1>
    <p class="lede">
      Put RELAY on a track, name a room, press Share. The audio goes straight from your machine to
      the listener. No account, and no server in the audio path.
    </p>
    <div class="actions">
      <a class="primary" href={download}>Download</a>
      <a class="secondary" href={listen}>Open a room</a>
    </div>

    <table aria-label="Where RELAY sends audio">
      <thead><tr><th>To</th><th>How</th><th>Audio</th></tr></thead>
      <tbody>
        {paths.map((p) => (
          <tr><td>{p.to}</td><td>{p.how}</td><td>{p.spec}</td></tr>
        ))}
      </tbody>
    </table>

    <p class="note">
      Rooms take an optional password. Cloudflare only introduces the two ends; it never sees the
      audio or the password. Up to 16 listeners per room, each streamed directly from your machine.
      CLAP and VST3.
    </p>
  </main>
</Base>

<style>
  main { padding-top: 40px; }

  h1 {
    margin: 0;
    font-size: clamp(30px, 6vw, 44px);
    font-weight: 700;
    line-height: 1.05;
    letter-spacing: -0.02em;
  }

  .lede { margin: 12px 0 0; max-width: 50ch; font-size: 16px; color: var(--dim); }

  .actions { display: flex; flex-wrap: wrap; gap: 8px; margin-top: 20px; }

  .actions a {
    display: inline-flex;
    align-items: center;
    height: 40px;
    padding: 0 16px;
    border-radius: var(--r);
    font-weight: 700;
    letter-spacing: 0.14em;
    text-transform: uppercase;
    text-decoration: none;
  }

  .primary { background: var(--accent); color: var(--ink); }
  .secondary { background: var(--field); color: var(--text); }
  .primary:hover { filter: brightness(1.1); }
  .secondary:hover { background: var(--hover); }

  table {
    width: 100%;
    margin-top: 40px;
    border-collapse: collapse;
    background: var(--field);
    border-radius: var(--r);
    overflow: hidden;
  }

  th, td { padding: 10px 12px; border-top: 1px solid var(--line); text-align: left; vertical-align: top; }
  th { color: var(--dim); font-size: 11px; letter-spacing: 0.12em; text-transform: uppercase; }

  .note { margin: 12px 0 0; max-width: 70ch; color: var(--dim); }

  @media (max-width: 640px) {
    thead { display: none; }
    tr { display: grid; padding: 10px 12px; border-top: 1px solid var(--line); gap: 2px; }
    tr:first-child { border-top: 0; }
    td { padding: 0; border: 0; }
    td:nth-child(2) { color: var(--dim); }
  }
</style>
